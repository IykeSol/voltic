# Copy to .env and fill in. The app runs fully without a Gemini key
# (it falls back to a built-in deterministic analysis).

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Billing assumption (Naira per kWh) used as the default tariff
DEFAULT_TARIFF=68.0
